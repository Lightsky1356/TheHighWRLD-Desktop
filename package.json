{
  "name": "thehighwrld-desktop",
  "productName": "TheHighWRLD",
  "version": "1.0.0",
  "description": "TheHighWRLD - native desktop app (Windows EXE / macOS DMG / Linux). Optional Discord Rich Presence.",
  "author": {
    "name": "TheHighWRLD",
    "email": "thehighwrld@example.com"
  },
  "homepage": "https://thehighwrlddashboard.pages.dev",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.thehighwrld.dashboard",
    "productName": "TheHighWRLD",
    "files": [
      "src/**/*",
      "assets/**/*",
      "settings.html",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/ffmpeg.dll",
        "to": "ffmpeg.dll"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    }
  }
}
